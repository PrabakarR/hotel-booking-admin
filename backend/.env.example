# Supabase PostgreSQL — pooled connection (port 6543, pgBouncer)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL — direct connection (port 5432) used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=3001
FRONTEND_URL="http://localhost:3000"

# Used only by prisma/seed.ts — never use this password in production
SEED_ADMIN_EMAIL="admin@hotel.com"
SEED_ADMIN_PASSWORD="password123"
SEED_ADMIN_NAME="Front Desk Admin"
